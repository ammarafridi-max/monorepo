# Copy to .env and fill in. Never commit real values.

# MongoDB connection string
MONGODB_URI=

# Redis connection string (BullMQ)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Replicate
REPLICATE_API_TOKEN=
# The model trainings push trained versions onto, as "owner/name". Created
# automatically if it does not exist. One destination is reused for all orders;
# each training still produces its own version.
REPLICATE_DESTINATION_MODEL=
# Optional: override the pinned flux-dev-lora-trainer version hash.
REPLICATE_TRAINER_VERSION=
# Optional: hardware tier used when auto-creating the destination model.
REPLICATE_DESTINATION_HARDWARE=
# Optional: LoRA strength at generation time (float, sane range ~0.8-1.1; higher
# = stronger trained identity on weak seeds, but risks artifacts). Default 1.0.
# Only affects the cheap GENERATING stage, never training.
GEN_LORA_SCALE=
# Optional dev override: a publicly reachable zip of ~10-15 selfies to train
# every order on. When set, the worker skips building a zip from the order's real
# uploaded images. Leave blank in production.
TEST_IMAGE_ZIP_URL=

# Object storage (Cloudflare R2, S3-compatible). Selfies are uploaded directly
# from the browser via presigned PUT; the worker writes the training zip here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL that serves the bucket's objects (r2.dev or a custom domain).
R2_PUBLIC_BASE_URL=

# Email delivery (Resend). Sent once when an order reaches DELIVERED.
RESEND_API_KEY=
# A verified sender. Resend's onboarding@resend.dev works for testing.
EMAIL_FROM=Headliner <onboarding@resend.dev>

# Where the web app is served. Used for Stripe success/cancel URLs, CORS, and the
# results link in the delivery email.
WEB_BASE_URL=http://localhost:3000

# Read by the Next.js web app (apps/web): the api origin it calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Admin observability (GET /admin/orders). Leave blank to disable the endpoint.
# Send it as "Authorization: Bearer <token>" or an "x-admin-token" header.
ADMIN_TOKEN=
# Optional: minutes a non-terminal order may sit before it is flagged as stuck.
ADMIN_STUCK_MINUTES=30

# Upload quality gate (server-side face validation in POST /checkout). This is
# the REAL gate that stops paying for garbage input. It is ON by default and
# fails closed. Set to "off" ONLY for local dev without a vision provider.
UPLOAD_QUALITY_GATE=on
# Server-side detection uses AWS Rekognition DetectFaces. Standard AWS creds:
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Thresholds (server). Keep the NEXT_PUBLIC_ client copies below in sync.
UPLOAD_MIN_PHOTOS=5
UPLOAD_MAX_PHOTOS=15
# Face bounding box must span at least this fraction of the image (larger side).
UPLOAD_MIN_FACE_RATIO=0.15
# Client copies of the thresholds (read by the web app for its UX pre-check).
NEXT_PUBLIC_UPLOAD_MIN_PHOTOS=5
NEXT_PUBLIC_UPLOAD_MAX_PHOTOS=15
NEXT_PUBLIC_UPLOAD_MIN_FACE_RATIO=0.15
