# Copy to .env and fill in. Never commit real values.

# MongoDB connection string
MONGODB_URI=

# Redis connection string (BullMQ)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Replicate
REPLICATE_API_TOKEN=
# The model trainings push trained versions onto, as "owner/name". Created
# automatically if it does not exist. One destination is reused for all orders;
# each training still produces its own version.
REPLICATE_DESTINATION_MODEL=
# Optional: override the pinned flux-dev-lora-trainer version hash.
REPLICATE_TRAINER_VERSION=
# Optional: hardware tier used when auto-creating the destination model.
REPLICATE_DESTINATION_HARDWARE=

# TODO (Phase 4): replace with a zip built from the order's real uploaded images.
# For now, a publicly reachable zip of ~10-15 selfies the worker trains on.
TEST_IMAGE_ZIP_URL=
