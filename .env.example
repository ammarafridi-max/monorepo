# Copy to .env and fill in. Never commit real values.

# MongoDB connection string
MONGODB_URI=

# Redis connection string (BullMQ)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Replicate
REPLICATE_API_TOKEN=
# The model trainings push trained versions onto, as "owner/name". Created
# automatically if it does not exist. One destination is reused for all orders;
# each training still produces its own version.
REPLICATE_DESTINATION_MODEL=
# Optional: override the pinned flux-dev-lora-trainer version hash.
REPLICATE_TRAINER_VERSION=
# Optional: hardware tier used when auto-creating the destination model.
REPLICATE_DESTINATION_HARDWARE=
# Optional: LoRA strength at generation time (float, sane range ~0.8-1.1; higher
# = stronger trained identity on weak seeds, but risks artifacts). Default 1.0.
# Only affects the cheap GENERATING stage, never training.
GEN_LORA_SCALE=
# Optional: how many headshots to deliver per order (default 14). Identity culling
# is off by default, so the worker generates EXACTLY this many (generate == deliver,
# no wasted images). GENERATE_COUNT (default 20) only applies if culling is enabled
# via REPLICATE_FACE_EMBED_MODEL below.
DELIVER_COUNT=
GENERATE_COUNT=
# Optional: identity culling. Set to a face-EMBEDDING model "owner/name:versionHash"
# that takes { image } and returns a numeric vector (e.g. our CPU cog
# ammarafridi-max/face-embed) to overgenerate and deliver only the candidates that
# best match the customer's selfies. UNSET = OFF. See the "Identity-based candidate
# culling" README section.
REPLICATE_FACE_EMBED_MODEL=
# Optional: identity lock via FACE SWAP. Set to a face-swap model "owner/name:hash"
# (e.g. cdingram/face-swap) to swap the customer's real face onto each delivered
# headshot -- fixes face shape / hair / expression the LoRA drifts on. UNSET = OFF.
REPLICATE_FACE_SWAP_MODEL=
# Delivered-image durability. ON by default: the worker copies the FINAL delivered
# images into our R2 bucket (keys deliveries/<orderId>/<i>) so they never 404 when
# the upstream replicate.delivery URLs are garbage-collected (~1 hour). Requires R2
# (already required for uploads). Set to "off" to serve the ephemeral upstream URLs.
PERSIST_DELIVERED=on
# Generation backend: 'lora' (default; per-user LoRA training + generation, with
# optional culling/swap) or 'pulid' (NO training; identity from a reference selfie
# via bytedance/flux-pulid at generation time -- fixes face shape, ~$0.02/image,
# minutes not ~25). PuLID forces culling + swap OFF.
GENERATION_BACKEND=
# PuLID knobs (only used when GENERATION_BACKEND=pulid). PULID_MODEL defaults to a
# pinned bytedance/flux-pulid version; PULID_ID_WEIGHT (default 1) is identity
# strength (~0.8-1.3; higher = tighter identity, too high looks baked).
PULID_MODEL=
PULID_ID_WEIGHT=
# Vision model that infers facial hair from the reference selfie when the customer
# left the field blank (so PuLID draws the real beard, not a generic short one).
# Defaults to a pinned lucataco/qwen2-vl-7b-instruct.
PULID_VISION_MODEL=
# Optional dev override: a publicly reachable zip of ~10-15 selfies to train
# every order on. When set, the worker skips building a zip from the order's real
# uploaded images. Leave blank in production.
TEST_IMAGE_ZIP_URL=

# Object storage (Cloudflare R2, S3-compatible). Selfies are uploaded directly
# from the browser via presigned PUT; the worker writes the training zip here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL that serves the bucket's objects (r2.dev or a custom domain).
R2_PUBLIC_BASE_URL=

# Email delivery (Brevo transactional). Sent once when an order reaches DELIVERED.
# Leave BREVO_API_KEY empty to disable email in local dev: delivery becomes a
# clean no-op and the worker still reaches DELIVERED.
BREVO_API_KEY=
# The From identity, as "Name <email>". The email must be a verified Brevo sender.
BREVO_SENDER=Picturesk.ai <hello@picturesk.ai>

# Where the web app is served. Used for Stripe success/cancel URLs, CORS, and the
# results link in the delivery email.
WEB_BASE_URL=http://localhost:3000

# Read by the Next.js web app (apps/web): the api origin it calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional accounts (apps/web). Buying stays anonymous; this is only for the
# optional login/account layer. AUTH_SECRET signs session cookies (generate with
# `openssl rand -hex 32`). The web app also reads MONGODB_URI (above) for the
# users collection and order history.
AUTH_SECRET=

# Optional social sign-in (apps/web). Each provider appears on the login and
# signup pages ONLY when both its id and secret are set; leave a provider blank to
# hide it. Social sign-in establishes the same account session as email + password.
# Register this authorized redirect URI with each provider (built from WEB_BASE_URL):
#   <WEB_BASE_URL>/api/auth/oauth/google/callback
#   <WEB_BASE_URL>/api/auth/oauth/facebook/callback
#   <WEB_BASE_URL>/api/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# LinkedIn: enable the "Sign In with LinkedIn using OpenID Connect" product on the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Admin observability. Break-glass, single-shared-secret access to the read-only
# admin data routes: GET /admin/orders, /admin/orders/:id, /admin/stats,
# /admin/customers. Send it as "Authorization: Bearer <token>" or an "x-admin-token"
# header (for scripts/monitoring). Leave blank to disable this header path; the real
# staff login below is what humans use in the admin UI.
ADMIN_TOKEN=
# Optional: minutes a non-terminal order may sit before it is flagged as stuck.
ADMIN_STUCK_MINUTES=30

# --- Admin panel (staff accounts) ------------------------------------------
# Real admin login: POST /auth/login with email+password issues an httpOnly JWT
# cookie (picturesk_admin) that the admin UI uses. Set on the API service.
# ADMIN_JWT_SECRET signs the admin session (generate with: openssl rand -hex 32).
# Leave blank to disable staff login entirely (/auth returns 503).
ADMIN_JWT_SECRET=
# How long an admin session lasts. Keep the cookie lifetime == the token lifetime.
ADMIN_JWT_EXPIRES_IN=7d
ADMIN_COOKIE_EXPIRES_DAYS=7
# Bootstrap the first admin with: pnpm --filter @picturesk/api seed-admin
# (override these; do NOT ship the default password). The api hashes SEED_PASSWORD
# before storing it, so set a strong one. Idempotent: skips if any admin exists.
SEED_NAME=Super Admin
SEED_USERNAME=superadmin
SEED_EMAIL=admin@picturesk.ai
SEED_PASSWORD=

# Upload quality gate (server-side face validation in POST /checkout). This is
# the REAL gate that stops paying for garbage input. It is ON by default and
# fails closed. Set to "off" ONLY for local dev without a vision provider.
UPLOAD_QUALITY_GATE=on
# Server-side detection runs on Replicate (reuses REPLICATE_API_TOKEN above), the
# ultralytics/yolov8s-worldv2 detector on the "person" class. Optional overrides:
REPLICATE_FACE_MODEL_VERSION=
REPLICATE_FACE_CONF=
# STRICT screen (sunglasses / hats / blur / dark) via a vision model, on top of face
# detection. ON by default (needs UPLOAD_QUALITY_GATE on). A clean training set is
# the biggest lever on likeness. Set to "off" to disable; override the model here.
UPLOAD_STRICT_GATE=on
UPLOAD_PHOTO_GATE_MODEL=
# Thresholds (server). Keep the NEXT_PUBLIC_ client copies below in sync.
UPLOAD_MIN_PHOTOS=5
UPLOAD_MAX_PHOTOS=15
# Face bounding box must span at least this fraction of the image (larger side).
UPLOAD_MIN_FACE_RATIO=0.15
# Client copies of the thresholds (read by the web app for its UX pre-check).
NEXT_PUBLIC_UPLOAD_MIN_PHOTOS=5
NEXT_PUBLIC_UPLOAD_MAX_PHOTOS=15
NEXT_PUBLIC_UPLOAD_MIN_FACE_RATIO=0.15

# Content moderation (server-side, in POST /checkout, alongside the face gate).
# Screens each uploaded image for unsafe content BEFORE a Stripe session exists.
# Reuses REPLICATE_API_TOKEN (same as the face detector). ON by default; set to
# "off" only for local dev without a classifier wired up.
UPLOAD_MODERATION=on
# The classifier, as "owner/name" on Replicate (run by its latest version). Swap
# for a dedicated moderation service by replacing apps/api/contentModerator.js.
REPLICATE_MODERATION_MODEL=falcons-ai/nsfw_image_detection
# Optional: pin an exact version hash instead of using the model's latest.
REPLICATE_MODERATION_MODEL_VERSION=
# NSFW score (0..1) at or above which an image is rejected. Conservative but not
# so strict it trips on ordinary selfies. Default 0.85.
REPLICATE_MODERATION_NSFW_THRESHOLD=0.85
# When the classifier ITSELF errors (outage/misconfig): "true" = fail open (allow
# + alert) so a moderation outage does not block all checkouts; "false" = fail
# closed (block). A POSITIVE detection is always blocked regardless. Default true.
UPLOAD_MODERATION_FAIL_OPEN=true

# Funnel analytics (apps/web). Cookieless, privacy-light (Plausible), no PII.
# UNSET => no analytics script loads and every event is a no-op (clean local dev).
# Set to your Plausible site domain to enable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Optional: override the analytics script URL (e.g. a self-hosted Plausible or a
# proxied path). Defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=

# ------------------------------------------------------------------------------
# Production safety
# ------------------------------------------------------------------------------

# Abuse protection / rate limiting (apps/api). Per-IP limits on the public API.
# All are optional; sane defaults apply if unset. The Stripe webhook is never
# rate limited.
# Number of proxy hops in front of the API, so req.ip is the real client IP and
# not the proxy (or a spoofable header). Fly.io = 1. Never set this to trust all.
TRUST_PROXY_HOPS=1
# Sliding window for all limiters (default 900000 = 15 minutes).
RATE_LIMIT_WINDOW_MS=900000
# Global backstop per IP per window (default 600, well above the poll rate).
RATE_LIMIT_MAX=600
# Stricter caps on the money/storage endpoints, per IP per window.
RATE_LIMIT_PRESIGN_MAX=20
RATE_LIMIT_CHECKOUT_MAX=10

# Error tracking (Sentry). Unset => Sentry is DISABLED and every service still
# boots and runs normally; nothing is sent. Set the DSN(s) to turn it on.
# One DSN is read by the api, the worker, and the web server/edge runtimes. Point
# them at one Sentry project or use separate projects per service if you prefer.
SENTRY_DSN=
# The web browser needs a PUBLIC DSN (inlined at build). Can equal SENTRY_DSN.
# NOTE: this is a build-time value, so the web app must be rebuilt to enable it.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: environment tag on events (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: performance tracing sample rate (0..1). Default 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0
# Optional: release/version tag on events.
SENTRY_RELEASE=
# Optional (web only): source-map upload during `next build`. All three needed to
# upload; leave blank to skip upload (Sentry still captures errors without maps).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
