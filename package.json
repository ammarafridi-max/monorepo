{
  "name": "picturesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm --filter @picturesk/api dev\" \"pnpm --filter @picturesk/worker dev\"",
    "web": "pnpm --filter @picturesk/web dev",
    "api": "pnpm --filter @picturesk/api dev",
    "worker": "pnpm --filter @picturesk/worker dev",
    "deploy:api": "fly deploy -c fly.api.toml",
    "deploy:web": "fly deploy -c fly.web.toml",
    "deploy:worker": "fly deploy -c fly.worker.toml"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
