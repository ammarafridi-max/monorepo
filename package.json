{
  "name": "headliner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm --filter @headliner/api dev\" \"pnpm --filter @headliner/worker dev\"",
    "web": "pnpm --filter @headliner/web dev",
    "api": "pnpm --filter @headliner/api dev",
    "worker": "pnpm --filter @headliner/worker dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
