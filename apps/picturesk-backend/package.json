{
  "name": "@travel-suite/picturesk-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=.env.development --watch src/server.js",
    "dev:worker": "NODE_ENV=development node --env-file=.env.development --watch src/worker.js",
    "dev:all": "concurrently -n server,worker -c blue,magenta \"pnpm dev\" \"pnpm dev:worker\"",
    "start": "node --env-file=.env.production src/server.js",
    "start:worker": "node --env-file=.env.production src/worker.js",
    "test": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@sentry/node": "^10.64.0",
    "@travel-suite/admin-users": "workspace:*",
    "@travel-suite/auth": "workspace:*",
    "@travel-suite/picturesk-shared": "workspace:*",
    "@travel-suite/utils": "workspace:*",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jszip": "^3.10.1",
    "mongoose": "^9.0.2",
    "sharp": "^0.33.5",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "mongodb-memory-server": "^10.1.2"
  },
  "engines": {
    "node": "22.x"
  }
}
