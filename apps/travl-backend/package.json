    "@travel-suite/itineraries": "workspace:*",
    "@travel-suite/locations": "workspace:*",
    "@travel-suite/notifications": "workspace:*",
    "@travel-suite/payments": "workspace:*",
    "@travel-suite/serpapi": "workspace:*",
    "@travel-suite/utils": "workspace:*",
